# n8n automation layer — operator environment.
# Copy to `.env` on the server and fill in REAL values. NEVER commit `.env`.
# All values below are PLACEHOLDERS.

# --- Public domain served by Caddy (automatic HTTPS) ---
# Example: N8N_HOST=n8n.example.com
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/

# --- n8n ---
# REQUIRED. Generate once: `openssl rand -hex 32`.
# BACK IT UP in a password manager. Losing it orphans every credential
# stored in n8n — they cannot be decrypted or recovered without it.
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Basic auth for the n8n editor UI.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_long_random_password

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=n8n

# --- Timezone ---
# Change to the operator's timezone. Cron/Schedule nodes use this.
GENERIC_TIMEZONE=America/New_York
