{
  "connections": {
    "AI summarizer (stub)": {
      "main": [
        [
          {
            "index": 0,
            "node": "Draft queue (stub)",
            "type": "main"
          }
        ]
      ]
    },
    "Dedupe by link": {
      "main": [
        [
          {
            "index": 0,
            "node": "Keyword filter",
            "type": "main"
          }
        ]
      ]
    },
    "Draft queue (stub)": {
      "main": [
        [
          {
            "index": 0,
            "node": "Notify operator (stub)",
            "type": "main"
          }
        ]
      ]
    },
    "Every 2 hours": {
      "main": [
        [
          {
            "index": 0,
            "node": "RSS Read",
            "type": "main"
          }
        ]
      ]
    },
    "Keyword filter": {
      "main": [
        [
          {
            "index": 0,
            "node": "AI summarizer (stub)",
            "type": "main"
          }
        ]
      ]
    },
    "RSS Read": {
      "main": [
        [
          {
            "index": 0,
            "node": "Dedupe by link",
            "type": "main"
          }
        ]
      ]
    }
  },
  "name": "rss-to-social-drafts (starter)",
  "nodes": [
    {
      "id": "rss-trigger-01",
      "name": "Every 2 hours",
      "notes": "Poll cadence for RSS feeds. Connect: nothing — but change the interval to suit the client.",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "rss-read-01",
      "name": "RSS Read",
      "notes": "Connect: replace url with the client's real feed(s). Use one node per feed, or a Merge node to combine several feeds into one stream.",
      "parameters": {
        "options": {},
        "url": "https://example.com/feed.xml"
      },
      "position": [
        460,
        300
      ],
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2
    },
    {
      "id": "dedupe-01",
      "name": "Dedupe by link",
      "notes": "Connect: nothing. Set options.scope to 'workflow' to dedupe across all feeds merged upstream. Uses 'Remove items repeated within previous executions' — n8n stores seen keys between runs; within-run dedupe alone would re-queue the same items every poll.",
      "parameters": {
        "operation": "removeItemsRepeatedWithinPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.link }}",
        "options": {
          "scope": "node"
        }
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2
    },
    {
      "id": "filter-01",
      "name": "Keyword filter",
      "notes": "Connect: replace the regex in the value field with the client's keywords, as /pattern/flags (JavaScript regex — inline flags like (?i) are invalid). True branch continues; False branch is dropped (or route to an archive).",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "filter-keyword",
              "leftValue": "={{ ($json.title || '') + ' ' + ($json.contentSnippet || '') }}",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "rightValue": "/\\b(gators?|florida)\\b/i"
            }
          ],
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      },
      "position": [
        900,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "credentials": {},
      "id": "ai-summarizer-01",
      "name": "AI summarizer (stub)",
      "notes": "STUB — Connect: point the URL at your real AI endpoint and create a 'Header Auth' credential for its API key (never paste the key into this node). JSON.stringify keeps quotes in headlines from breaking the body. Output is a DRAFT for the queue — nothing here publishes.",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://example-ai-api.local/v1/summarize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, url: $json.link, text: $json.contentSnippet || '', instruction: 'Write 3 hook options + a 2-sentence social caption + hashtags for this story. Return JSON: {hooks, caption, hashtags}. Draft only.' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "position": [
        1120,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "credentials": {},
      "id": "queue-01",
      "name": "Draft queue (stub)",
      "notes": "STUB — Connect: add a Google Sheets credential and set the real Sheet ID (or swap this node for Notion/Airtable). Columns above are placeholders the operator can rename. This queue is what the Scout→Scribe handoff reviews.",
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ai_caption": "={{ $json.caption }}",
            "ai_hooks": "={{ $json.hooks }}",
            "created_at": "={{ $now.toISO() }}",
            "source_url": "={{ $('Keyword filter').item.json.link }}",
            "status": "draft",
            "title": "={{ $('Keyword filter').item.json.title }}"
          }
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SHEET_ID"
        },
        "options": {},
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Drafts"
        },
        "operation": "append"
      },
      "position": [
        1340,
        300
      ],
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5
    },
    {
      "credentials": {},
      "id": "notify-01",
      "name": "Notify operator (stub)",
      "notes": "STUB — Connect: add a Telegram bot credential and real chat ID, or swap for email/Slack. Fires per new draft so Scribe knows there's something to review.",
      "parameters": {
        "additionalFields": {},
        "chatId": "@your_operator_channel",
        "text": "={{ 'New social draft queued: ' + $('Keyword filter').item.json.title }}"
      },
      "position": [
        1560,
        300
      ],
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2
    }
  ],
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "America/New_York"
  },
  "staticData": null,
  "active": false
}
